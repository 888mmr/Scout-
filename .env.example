# Local development placeholders only. Use URL-safe values for DB credentials.
POSTGRES_USER=scout
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=scout
APP_NAME=SCOUT
API_PORT=8000
# Used by Python outside Compose; Compose constructs its own URL with host db.
DATABASE_URL=postgresql+psycopg://scout:local-dev-only@localhost:5432/scout
